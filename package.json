{
  "name": "maintenance-diorama",
  "version": "1.0.0",
  "private": true,
  "description": "A cinematic, config-driven maintenance page served from a Cloudflare Worker: a rainy-night toon diorama of a Japanese street-corner construction site.",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "build": "node scripts/configure.mjs && esbuild scene/diorama.js --bundle --minify --format=esm --target=es2020 --outfile=dist/scene.bundle.txt --log-level=warning",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "on": "npm run build && wrangler deploy --var MAINTENANCE:on",
    "off": "npm run build && wrangler deploy --var MAINTENANCE:off",
    "remove": "npm run configure && wrangler delete"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.0",
    "esbuild": "^0.28.2",
    "simple-icons": "^16.33.0",
    "three": "^0.186.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.135.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
